2026-05-29 11:31:09,906 INFO agent.mcp RESULT tool=search_problem_knowledge output={"SubSituation": [], "Service": [], "ServiceQA": [{"question": "Welche Dokumente sind notwendig, um eine Anordnung beantragen zu können?", "answer": "Es gibt keine spezifischen Dokumente, die bei der Beantragung der Schutzmaßnahmen benötigt werden. Ein schriftlicher oder mündlicher Antrag reicht aus.", "confidence": 0.9, "service_id": "926", "sourceText": "Sie können den Antrag einreichen durch schriftlichen Antrag oder mündlich zur Niederschrift bei der Geschäftsstelle eines Amtsgerichts.", "id": "926_qa_3", "scrapedAt": "2026-05-25T23:36:52.682452", "category": "documents", "order": 3, "score": 0.9180156588554382, "entities": ["Amtsgericht", "Antrag", "Dokumente", "Schutzmaßnahmen"]}], "services": [{"found": true, "service": {"summary": "Diese Dienstleistung ermöglicht Opfern von Gewalt oder Stalking die Anordnung von Schutzmaßnahmen bei Familiengericht. Es sind vorausgesetzte Verletzungen der Körperintegrität, Gesundheit, Freiheit oder sexuellen Selbstbestimmung des Opfers durch den Täter oder drohende Gewaltanwendung, unbefugtes Eindringen in die Wohnung oder auf das Grundstück sowie wiederholte Nachstellungen (Stalking) relevant. Der Antrag kann schriftlich oder mündlich gestellt werden und wird von einem Richter bearbeitet. Die Schutzmaßnahmen haben eine bestimmte Dauer, können verlängert werden und fallen im ersten Rechtszug in der Regel keine Gerichtskosten an. Es gibt jedoch die Möglichkeit für Verfahrenskostenhilfe bei der Zwangsvollstreckung.", "name": "Gerichtliche Maßnahmen zum Schutz vor Gewalt und Nachstellungen - Anordnung beantragen", "description": "", "id": "926", "source": "service-bw", "scrapedAt": "", "url": "https://www.service-bw.de/zufi/leistungen/926"}, "sections": [{"html": "<p>Diese Dienstleistung ermöglicht es Opfern von Gewalt oder Stalking, Schutzanordnungen bei Familiengerichts zu beantragen. Diese Anordnungen können einschränkende Maßnahmen gegen die Täterin oder den Täter beinhalten.</p>", "id": "926_1", "text": "Diese Dienstleistung ermöglicht es Opfern von Gewalt oder Stalking, Schutzanordnungen bei Familiengerichts zu beantragen. Diese Anordnungen können einschränkende Maßnahmen gegen die Täterin oder den Täter beinhalten.", "type": "description", "title": "Beschreibung der Dienstleistung", "order": 1}, {"html": "<p>Schutzanordnungen kommen in Betracht, wenn die Täterin oder der Täter vorsätzlich den Körper, die Gesundheit, die Freiheit oder die sexuelle Selbstbestimmung des Opfers verletzt hat (zum Beispiel durch Gewaltanwendung), hiermit widerrechtlich gedroht hat, widerrechtlich und vorsätzlich in die Wohnung oder auf das Grundstück des Opfers eingedrungen ist oder das Opfer widerrechtlich und vorsätzlich durch wiederholte Nachstellungen (Stalking) gegen dessen ausdrücklich erklärten Willen oder auch durch Verfolgen über Fernkommunikationsmittel (zum Beispiel Telefon, SMS) unzumutbar belästigt.</p>", "id": "926_2", "text": "Schutzanordnungen kommen in Betracht, wenn die Täterin oder der Täter vorsätzlich den Körper, die Gesundheit, die Freiheit oder die sexuelle Selbstbestimmung des Opfers verletzt hat (zum Beispiel durch Gewaltanwendung), hiermit widerrechtlich gedroht hat, widerrechtlich und vorsätzlich in die Wohnung oder auf das Grundstück des Opfers eingedrungen ist oder das Opfer widerrechtlich und vorsätzlich durch wiederholte Nachstellungen (Stalking) gegen dessen ausdrücklich erklärten Willen oder auch durch Verfolgen über Fernkommunikationsmittel (zum Beispiel Telefon, SMS) unzumutbar belästigt.", "type": "requirements", "title": "Voraussetzungen", "order": 2}, {"html": "<p>Die Schutzanordnungen müssen Sie beim Familiengericht beantragen. Sie können den Antrag einreichen durch schriftlichen Antrag oder mündlich zur Niederschrift bei der Geschäftsstelle eines Amtsgerichts. Als Hilfestellung können Sie auch auf Formulierungsmuster zurückgreifen. Musterformulare für Schutzanträge finden Sie beispielsweise auf den Internetseiten der Berliner Initiative gegen Gewalt an Frauen - BIG e.V. Üblicherweise findet eine mündliche Verhandlung vor einer Richterin oder einem Richter statt. Das Gericht hört die Argumente jeder Partei und entscheidet über den Antrag. Das Gericht legt für alle Anordnungen eine bestimmte Dauer fest. Eine Verlängerung auf Antrag des Opfers ist möglich.</p>", "id": "926_3", "text": "Die Schutzanordnungen müssen Sie beim Familiengericht beantragen. Sie können den Antrag einreichen durch schriftlichen Antrag oder mündlich zur Niederschrift bei der Geschäftsstelle eines Amtsgerichts. Als Hilfestellung können Sie auch auf Formulierungsmuster zurückgreifen. Musterformulare für Schutzanträge finden Sie beispielsweise auf den Internetseiten der Berliner Initiative gegen Gewalt an Frauen - BIG e.V. Üblicherweise findet eine mündliche Verhandlung vor einer Richterin oder einem Richter statt. Das Gericht hört die Argumente jeder Partei und entscheidet über den Antrag. Das Gericht legt für alle Anordnungen eine bestimmte Dauer fest. Eine Verlängerung auf Antrag des Opfers ist möglich.", "type": "procedure", "title": "Verfahrensablauf", "order": 3}, {"html": "<p>Für das Opfer fallen im ersten Rechtszug in der Regel keine Gerichtskosten an. Das Gericht kann aber Kosten auferlegen. Etwa, wenn Ihr Antrag von vornherein keine Aussicht auf Erfolg hatte und Sie dies erkennen mussten. Betreiben Sie die Zwangsvollstreckung zur Durchsetzung der Schutzanordnung können für Sie Kosten entstehen, wenn diese von der Antragsgegenerin oder vom Antragsgegner nicht eingetrieben werden können. Sie können aber gegebenenfalls auch für einzelne Vollstreckungsmaßnahmen Verfahrenskostenhilfe beantragen.</p>", "id": "926_4", "text": "Für das Opfer fallen im ersten Rechtszug in der Regel keine Gerichtskosten an. Das Gericht kann aber Kosten auferlegen. Etwa, wenn Ihr Antrag von vornherein keine Aussicht auf Erfolg hatte und Sie dies erkennen mussten. Betreiben Sie die Zwangsvollstreckung zur Durchsetzung der Schutzanordnung können für Sie Kosten entstehen, wenn diese von der Antragsgegenerin oder vom Antragsgegner nicht eingetrieben werden können. Sie können aber gegebenenfalls auch für einzelne Vollstreckungsmaßnahmen Verfahrenskostenhilfe beantragen.", "type": "costs", "title": "Kosten", "order": 4}], "requirements": [{"confidence": 0.0, "sourceText": "", "id": "926_1", "text": "Schutzanordnung bei Gewalt oder Stalking", "type": "condition", "mandatory": true}], "documents": [], "authorities": [{"address": "", "phone": "", "name": "Familiengericht", "id": "926_1", "type": "court", "email": "", "locationContext": ""}], "forms": [], "steps": [{"channel": "online", "description": "Den Antrag einreichen durch schriftlichen Antrag oder mündlich zur Niederschrift bei der Geschäftsstelle eines Amtsgerichts.", "id": "926_1", "title": "Antrag einreichen", "order": 1}, {"channel": "in_person", "description": "Eine mündliche Verhandlung vor einer Richterin oder einem Richter statt.", "id": "926_2", "title": "Verhandlung", "order": 2}, {"channel": "online", "description": "Das Gericht hört die Argumente jeder Partei und entscheidet über den Antrag.", "id": "926_3", "title": "Entscheidung", "order": 3}, {"channel": "online", "description": "Eine Verlängerung auf Antrag des Opfers ist möglich.", "id": "926_4", "title": "Verlängerung", "order": 4}], "legal_basis": [{"id": "926_1", "text": "", "title": "Gesetz zum zivilrechtlichen Schutz vor Gewalttaten und Nachstellungen"}], "goals": [], "dependencies": [], "problems": [], "service_qa": [{"question": "Was ist die Dienstleistung?", "answer": "Diese Dienstleistung ermöglicht Opfern von Gewalt oder Stalking die Anordnung von Schutzmaßnahmen bei Familiengericht.", "confidence": 1.0, "service_id": "926", "sourceText": "Diese Dienstleistung ermöglicht Opfern von Gewalt oder Stalking die Anordnung von Schutzmaßnahmen bei Familiengericht.", "id": "926_qa_1", "scrapedAt": "2026-05-25T23:36:52.682425", "category": "