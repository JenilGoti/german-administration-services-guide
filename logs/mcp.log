2026-05-29 11:52:52,177 INFO agent.mcp RESULT tool=search_problem_knowledge output={"SubSituation": [], "Service": [{"summary": "Der Fischereischein ist erforderlich, um im Land Baden-Württemberg fischen oder angeln zu dürfen. Er ist gültig für das laufende Kalenderjahr und muss die Fischereiabgabe bezahlt werden. Jugendliche zwischen 7 und 15 Jahren können einen Jugendfischereischein beantragen, der unter Aufsicht einer volljährigen Person mit gültigem Fischereischein verwendet werden darf. Erwachsene müssen mindestens 10 Jahre alt sein und die Sachkunde nachweisen, was durch Teilnahme an einem vom Ministerium für Ernährung, Ländlichen Raum und Verbraucherschutz anerkannten Lehrgang erreicht wird. Der Antrag kann persönlich oder schriftlich bei der Gemeinde gestellt werden, wobei eine Vollmacht für andere Antragsteller benötigt ist. Die Gemeinde legt die Gebühren fest, und zusätzliche Fischereiabgabe beträgt 12 Euro pro Jahr. Der Fischereischein muss beim Fischen bei sich gehalten werden. Er gilt in anderen Bundesländern längstens bis zum Ende des nachfolgenden Kalenderjahres. Urlauber aus dem Ausland erhalten für vier Wochen innerhalb eines Kalenderjahres einen Fischereischein ohne Sachkunde.", "name": "Fischereischein beantragen", "description": "", "id": "242", "source": "service-bw", "scrapedAt": "2023-10-05T14:30:00Z", "url": "https://www.service-bw.de/zufi/leistungen/242", "score": 0.9032062888145447, "entities": ["Gemeinde", "Fischereischein"]}], "ServiceQA": [{"question": "Welche Dokumente sind notwendig, um den Organspende-Ausweis zu beantragen?", "answer": "Es gibt keine spezifischen Dokumente, die bei der Beantragung des Ausweises benötigt werden.", "confidence": 0.8, "service_id": "853", "sourceText": "", "id": "853_qa_2", "scrapedAt": "2026-05-25T23:04:13.238051", "category": "documents", "order": 2, "score": 0.9323662519454956, "entities": ["Dokumente", "Organspende-Ausweis"]}, {"question": "Welche Dokumente sind erforderlich, um die Niederlassungserlaubnis zu beantragen?", "answer": "Es werden keine expliziten Dokumente genannt. Allerdings müssen bestimmte Voraussetzungen erfüllt sein.", "confidence": 0.8, "service_id": "862", "sourceText": "", "id": "862_qa_2", "scrapedAt": "2026-05-25T23:08:39.950967", "category": "documents", "order": 2, "score": 0.9247918128967285, "entities": ["Niederlassungserlaubnis"]}], "services": [{"found": true, "service": {"summary": "Der Fischereischein ist erforderlich, um im Land Baden-Württemberg fischen oder angeln zu dürfen. Er ist gültig für das laufende Kalenderjahr und muss die Fischereiabgabe bezahlt werden. Jugendliche zwischen 7 und 15 Jahren können einen Jugendfischereischein beantragen, der unter Aufsicht einer volljährigen Person mit gültigem Fischereischein verwendet werden darf. Erwachsene müssen mindestens 10 Jahre alt sein und die Sachkunde nachweisen, was durch Teilnahme an einem vom Ministerium für Ernährung, Ländlichen Raum und Verbraucherschutz anerkannten Lehrgang erreicht wird. Der Antrag kann persönlich oder schriftlich bei der Gemeinde gestellt werden, wobei eine Vollmacht für andere Antragsteller benötigt ist. Die Gemeinde legt die Gebühren fest, und zusätzliche Fischereiabgabe beträgt 12 Euro pro Jahr. Der Fischereischein muss beim Fischen bei sich gehalten werden. Er gilt in anderen Bundesländern längstens bis zum Ende des nachfolgenden Kalenderjahres. Urlauber aus dem Ausland erhalten für vier Wochen innerhalb eines Kalenderjahres einen Fischereischein ohne Sachkunde.", "name": "Fischereischein beantragen", "description": "", "id": "242", "source": "service-bw", "scrapedAt": "2023-10-05T14:30:00Z", "url": "https://www.service-bw.de/zufi/leistungen/242"}, "sections": [{"html": "<p>Wenn Sie fischen oder angeln möchten, müssen Sie einen gültigen Fischereischein besitzen. Der Fischereischein ist gültig, wenn Sie für das laufende Kalenderjahr die Fischereiabgabe bezahlt haben. Dies gilt nicht für Jugendfischereischeine.</p>", "id": "242_1", "text": "Wenn Sie fischen oder angeln möchten, müssen Sie einen gültigen Fischereischein besitzen. Der Fischereischein ist gültig, wenn Sie für das laufende Kalenderjahr die Fischereiabgabe bezahlt haben. Dies gilt nicht für Jugendfischereischeine.", "type": "description", "title": "Beschreibung", "order": 1}, {"html": "<p>Fischereischein für Jugendliche (Jugendfischereischein) Sie sind zwischen 7 und 15 Jahre alt, Sie haben keinen Sachkundenachweis und Ihre Eltern oder deren Stellvertreter erklären ihr Einverständnis Mit einem Jugendfischereischein dürfen Sie nur unter Aufsicht einer volljährigen Person fischen, die einen gültigen Fischereischein besitzt. Der Jugendfischereischein gilt bis zum Ende des Jahres, in dem Sie 16 Jahre alt werden. Fischereischein auf Lebenszeit Sie sind mindestens 10 Jahre alt und Sie können die erforderliche Sachkunde nachweisen. Sie dürfen die Fischereiprüfung nur ablegen, wenn Sie erfolgreich an einem vom Ministerium für Ernährung, Ländlichen Raum und Verbraucherschutz anerkannten Lehrgang teilgenommen haben. Sie erhalten den Fischereischein in der Regel auf Lebenszeit, in Ausnahmefällen für ein Kalenderjahr.</p>", "id": "242_2", "text": "Fischereischein für Jugendliche (Jugendfischereischein) Sie sind zwischen 7 und 15 Jahre alt, Sie haben keinen Sachkundenachweis und Ihre Eltern oder deren Stellvertreter erklären ihr Einverständnis Mit einem Jugendfischereischein dürfen Sie nur unter Aufsicht einer volljährigen Person fischen, die einen gültigen Fischereischein besitzt. Der Jugendfischereischein gilt bis zum Ende des Jahres, in dem Sie 16 Jahre alt werden. Fischereischein auf Lebenszeit Sie sind mindestens 10 Jahre alt und Sie können die erforderliche Sachkunde nachweisen. Sie dürfen die Fischereiprüfung nur ablegen, wenn Sie erfolgreich an einem vom Ministerium für Ernährung, Ländlichen Raum und Verbraucherschutz anerkannten Lehrgang teilgenommen haben. Sie erhalten den Fischereischein in der Regel auf Lebenszeit, in Ausnahmefällen für ein Kalenderjahr.", "type": "requirements", "title": "Voraussetzungen", "order": 2}, {"html": "<p>die Gemeinde-/Stadtverwaltung beziehungsweise die Verwaltungsgemeinschaft des Hauptwohnortes Haben Sie als Antragstellerin oder Antragsteller keinen Hauptwohnsitz im Land, ist die Gemeinde zuständig, in deren Bezirk die Fischerei ausgeübt werden soll.</p>", "id": "242_3", "text": "die Gemeinde-/Stadtverwaltung beziehungsweise die Verwaltungsgemeinschaft des Hauptwohnortes Haben Sie als Antragstellerin oder Antragsteller keinen Hauptwohnsitz im Land, ist die Gemeinde zuständig, in deren Bezirk die Fischerei ausgeübt werden soll.", "type": "authorities", "title": "Zuständige Stelle", "order": 3}, {"html": "<p>Sie können den Fischereischein persönlich oder schriftlich bei Ihrer Gemeinde beantragen. Eine andere Person kann den Antrag auch für Sie stellen. Dieser Person müssen Sie dazu eine Vollmacht ausstellen.</p>", "id": "242_4", "text": "Sie können den Fischereischein persönlich oder schriftlich bei Ihrer Gemeinde beantragen. Eine andere Person kann den Antrag auch für Sie stellen. Dieser Person müssen Sie dazu eine Vollmacht ausstellen.", "type": "process_steps", "title": "Verfahrensablauf", "order": 4}, {"html": "<p>Personalausweis Passbild Sachkundenachweis: Zeugnis über die erfolgreiche Fischerprüfung</p>", "id": "242_5", "text": "Personalausweis Passbild Sachkundenachweis: Zeugnis über die erfolgreiche Fischerprüfung", "type": "requirements", "title": "Erforderliche Unterlagen", "order": 5}, {"html": "<p>Die Gemeinden legen die Gebühren für die Fischereischeine fest. Zusätzlich Fischereiabgabe: EUR 12,00 pro Jahr Diese Abgabe entfällt für den Jugendfischereischein.</p>", "id": "242_6", "text": "Die Gemeinden legen die Gebühren für die Fischereischeine fest. Zusätzlich Fischereiabgabe: EUR 12,00 pro Jahr Diese Abgabe entfällt für den Jugendfischereischein.", "type": "requirements", "title": "Kosten", "order": 6}, {"html": "", "id": "242_7", "text": "Sie müssen den Fischereischein beim Fischen bei sich haben. Die Fischereischeine aus den verschiedenen Bundesländern gelten in der Regel in ganz Deutschland. Wenn Sie Ihren Hauptwohnsitz aus einem anderen Bundesland nach Baden-Württemberg verlegen, gilt der Fischereischein des anderen Bundeslands längstens bis zum Ende des nachfolgenden Kalenderjahres. Urlauber aus dem Ausland erhalten ohne Sachkundenachweis für vier Wochen innerhalb eines Kalenderjahres einen Fischereischein.", "type": "requirements", "title": "Hinweise", "order": 7}], "requirements": [{"confidence": 0.9, "sourceText": "Personalausweis Passbild Sachkundenachweis: Zeugnis über die erfolgreiche Fischerprüfung", "id": "242_1", "text": "Personalausweis", "type": "document", "mandatory": true}, {"confidence": 0.9, "sourceText": "Personalausweis Passbild Sachkundenachweis: Zeugnis über die erfolgreiche Fischerprüfung", "id": "242_2", "text": "Passbild", "type": "document", "mandatory": true}, {"confidence": 0.9, "sourceText": "Personalausweis Passbild Sachkundenachweis: Zeugnis über die erfolgreiche Fischerprüfung", "id": "242_3", "text": "Sachkundenachweis", "type": "document", "mandatory": true}, {"confidence": 0.9, "sourceText": "Die Gemeinden legen die Gebühren für die Fischereischeine fest. Zusätzlich Fischereiabgabe: EUR 12,00 pro Jahr Diese Abgabe entfällt für den Jugendfischereischein.", "id": "242_4", "text": "Fischereiabgabe", "type": "payment", "mandatory": true}], "documents": [], "authorities": [{"address": "", "phone": "", "name": "Gemeinde-/Stadtverwaltung beziehungsweise die Verwaltungsgemeinschaft des Hauptwohnortes", "id": "242_1", "type": "government_body", "email": "", "locationContext": "local"}], "forms": [], "steps": [{"channel": "online", "id": "242_1", "title": "Antrag bei der Gemeinde stellen", "order": 1}, {"channel": "online", "id": "242_2", "title": "Vollmacht für einen anderen Antragsteller", "order": 2}], "legal_basis": [{"id": "242_1", "text": "Gesetz über Fischerei und Jagd (FJG)"}], "goals": [], "d