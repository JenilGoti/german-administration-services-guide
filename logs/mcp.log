2026-05-29 13:00:45,563 INFO agent.mcp RESULT tool=web_search output=[{"title": "Schulzeugnis - Ersatz bei Verlust beantragen", "url": "https://www.service-bw.de/leistung/-/sbw/Schulzeugnis++Ersatz+bei+Verlust+beantragen-569-leistung-0", "snippet": "Um den vollen Funktionsumfang dieser Webseite zu nutzen, benötigen Sie JavaScript. Hier finden Sie die Anleitung wie Sie JavaScript in Ihrem Browser einschalten · JavaScript is required to be able to use the full functional scope of this website. Here you will find the instructions for the ..."}, {"title": "Bürgerdienste: Schulzeugnis - Ersatz bei Verlust beantragen", "url": "https://web1.karlsruhe.de/service/Buergerdienste/leistung.php?id=569", "snippet": "Wenn Sie ein Abschluss- oder Abgangszeugnis verloren haben, können Sie ein Ersatzzeugnis beantragen · die Schule, die das Originalzeugnis ausgestellt hat"}, {"title": "Schulzeugnis – Ersatz bei Verlust oder nach Namensänderung beantragen", "url": "https://www.service.bremen.de/dienstleistungen/schulzeugnis-ersatz-bei-verlust-oder-nach-namensaenderung-beantragen-189704", "snippet": "Schulzeugnis – Ersatz bei Verlust oder nach Namensänderung beantragen"}, {"title": "Schulzeugnis - Ersatz bei Verlust beantragen", "url": "https://landesschulamt.sachsen-anhalt.de/fileadmin/Bibliothek/Landesjournal/Bildung_und_Wissenschaft/Landesschulamt/service/Schulzeugnisse_-_Verlust.pdf", "snippet": "Schulzeugnis - Ersatz bei Verlust beantragen · Wer kann mir bei Verlust ein Abschluss- oder Abgangszeugnis neu ausstellen"}, {"title": "Zeugnis verloren: So bekommen Sie Ersatz - FOCUS online", "url": "https://praxistipps.focus.de/zeugnis-verloren-so-bekommen-sie-ersatz_125543", "snippet": "May 12, 2025 - Können Sie ein Zeugnis aus Ihrer Schul- oder Hochschulzeit nicht mehr finden, ist noch nicht alles verloren. Ersatz für verschollene Zeugnisse erhalten Sie direkt bei Ihrer Schule, dem Schulamt oder bei Ihrer Hochschule."}]
