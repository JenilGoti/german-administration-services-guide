2026-05-29 13:29:24,617 INFO agent.mcp RESULT tool=search_problem_knowledge output={"SubSituation": [{"summary": "Die Blaue Karte EU ist ein Aufenthaltstitel für ausländische Akademikerinnen und Akademiker mit vergleichbaren Qualifikationen, die in Deutschland eine qualifizierte Beschäftigung suchen. Sie können unter erleichterten Bedingungen eine Niederlassungserlaubnis erhalten.", "name": "Blaue Karte EU (\"Blue Card EU\")", "description": "Die Blaue Karte EU ist ein besonderer Aufenthaltstitel für ausländische Akademikerinnen und Akademiker oder Personen mit vergleichbarem Qualifikationsniveau, die in Deutschland eine qualifizierte Beschäftigung aufnehmen wollen. Voraussetzungen sind unter anderem ein deutscher Hochschulabschluss, ein anerkannter ausländischer Hochschulabschluss oder ein ausländischer Hochschulabschluss, der mit einem deutschen Hochschulabschluss vergleichbar ist, ein den Qualifikationen entsprechender Arbeitsplatz und ein Mindestbruttogehalt. Inhaberinnen und Inhaber einer Blauen Karte EU können unter erleichterten Bedingungen eine Niederlassungserlaubnis erhalten.\n\nNiederlassungserlaubnis\n\n§ 18g Aufenthaltsgesetz (AufenthG) (Blaue Karte EU)\n\n17.04.2026 Justizministerium Baden-Württemberg", "id": "5000477", "scrapedAt": "2026-05-03T18:23:00.731877", "url": "https://www.service-bw.de/zufi/lebenslagen/5000477", "isSelf": false, "score": 0.8751655220985413, "entities": ["Arbeitsplatz", "Niederlassungserlaubnis", "Blaue Karte EU", "deutscher Hochschulabschluss", "ausländischer Hochschulabschluss", "Qualifikationen", "Mindestbruttogehalt"]}], "Service": [{"summary": "Ein EU-Heimtierausweis ist ein offizieller Beweis, dass Ihr Haustier mit einem Mikrochip gekennzeichnet und gegen Tollwut impft. Dieser Ausweis wird benötigt, wenn Sie mit Ihrem Tier in ein nicht gelistetes Drittländer reisen möchten. Um den EU-Heimtierausweis zu beantragen, muss Ihr Haustier bereits mit einem Mikrochip gekennzeichnet sein. Die Ausstellung des Heimtierausweises erfolgt durch einen Tierarzt, der die Identifizierung des Tiers durchführt und den Ausweis ausstellt. Es kann auch schon erfolgte Impfungen in den Heimtierausweis übertragen werden. Die Kosten variieren je nachdem, ob das Tier geimpft oder gekennzeichnet werden muss. Der Rechtsgrundlage dient die Verordnung (EU) Nr. 576/2013 über die Verbringung von Heimtieren zu anderen als Handelszwecken.", "name": "EU-Heimtierausweis (Pet Passport) beantragen", "description": "", "id": "138", "source": "service-bw", "scrapedAt": "", "url": "https://www.service-bw.de/zufi/leistungen/138", "score": 0.874006986618042, "entities": ["EU-Heimtierausweis", "Haustier"]}], "ServiceQA": [{"question": "Welche Dokumente sind erforderlich, um ein Ersatzzeugnis zu beantragen?", "answer": "Ein gültiger Personalausweis oder Reisepass als Identitätsnachweis.", "confidence": 1.0, "service_id": "569", "sourceText": "Personalausweis oder Reisepass als Identitätsnachweis", "id": "569_qa_2", "scrapedAt": "2026-05-25T20:06:23.946507", "category": "documents", "order": 2, "score": 0.9051809906959534, "entities": ["Personalausweis", "Reisepass", "Dokumente", "Ersatzzeugnis"]}, {"question": "Welche Dokumente sind notwendig für den Antrag?", "answer": "Es gibt keine spezifischen Dokumente, die beim Antragen der Ehrenpatenschaft vorgelegt werden müssen.", "confidence": 0.5, "service_id": "670", "id": "670_qa_2", "scrapedAt": "2026-05-25T22:01:49.675899", "category": "documents", "order": 2, "score": 0.9050760269165039, "entities": ["Ehrenpatenschaft"]}, {"question": "Wer kann eine Blaue Karte EU beantragen?", "answer": "Einwanderer in das Bundesgebiet Baden-Württemberg können eine Blaue Karte EU beantragen.", "confidence": 0.9, "service_id": "2059", "sourceText": "", "id": "2059_qa_2", "scrapedAt": "2026-05-25T16:41:22.334998", "category": "eligibility", "order": 2, "score": 0.8911710977554321, "entities": ["Baden-Württemberg", "Blaue Karte EU"]}, {"question": "Welche Dokumente sind erforderlich, um eine eID-Karte zu beantragen?", "answer": "Eine gültige Personalausweis- oder Passkarte sowie ein Nachweis des Wohnsitzes.", "confidence": 0.95, "service_id": "6005621", "sourceText": "Die eID-Karte kann persönlich bei der zuständigen Stelle beantragt werden; es ist empfehlenswert, einen Termin zu vereinbaren. Die Kosten betragen EUR 37,00 für den Kartenantrag und zusätzliche Gebühren bei Versand des PIN-Briefes ins Ausland. Die Bearbeitung dauert etwa drei bis sechs Wochen. Der Bundesinnenministerium bietet Informationen zur eID-Karte in Englisch an. Es ist wichtig, die eID-Karte unverzüglich vorzulegen, wenn eine Eintragung falsch ist, und den Verlust der Karte zu melden.", "id": "6005621_qa_2", "scrapedAt": "2026-05-25T20:41:43.532452", "category": "documents", "order": 2, "score": 0.8690732717514038, "entities": ["Personalausweis", "Bundesinnenministerium", "Wohnsitz", "eID-Karte", "Passkarte"]}, {"question": "Welche Voraussetzungen müssen erfüllt sein, um eine Fahrerkarte beantragen zu können?", "answer": "Der Antragsteller muss seinen Wohnsitz in Deutschland haben und einen gültigen EU-Kartenführerschein besitzen.", "confidence": 1.0, "service_id": "1998", "sourceText": "Sie müssen Ihren Wohnsitz in Deutschland haben. Sie besitzen einen gültigen EU-Kartenführerschein.", "id": "1998_qa_1", "scrapedAt": "2026-05-25T16:21:22.103169", "category": "eligibility", "order": 1, "score": 0.8809027075767517, "entities": ["Deutschland", "Wohnsitz", "Kartenführerschein", "EU-Kartenführerschein", "Fahrerkarte"]}], "services": [{"found": true, "service": {"summary": "Die Antragstellung auf die Blaue Karte EU zur Ausübung einer hochqualifizierten Beschäftigung ist ein Vorgang, bei dem Einwanderer in das Bundesgebiet Baden-Württemberg einreisen und arbeiten können. Der Antrag muss im Heimatland an der deutschen Auslandsvertretung (Botschaft oder Konsulat) gestellt werden. Nach der Einreise muss der Antragsteller den Aufenthaltstitel bei der zuständigen Ausländerbehörde, die je nach Wohnort entweder die Stadtverwaltung oder das Landratsamt ist, schriftlich beantragen. Es sind wichtige Anlagen erforderlich, darunter Nachweise des Mindestgehalts, Hochschulabschlusses und Arbeitsplatzes. Die Behörden prüfen auch, ob der Antragsteller die Interessen der Bundesrepublik Deutschland nicht gefährdet oder beeinträchtigt. Die Bearbeitung dauert in der Regel vier bis acht Wochen.", "name": "Blaue Karte EU zur Ausübung einer hochqualifizierten Beschäftigung beantragen", "description": "", "id": "2059", "source": "service-bw", "scrapedAt": "", "url": "https://www.service-bw.de/zufi/leistungen/2059"}, "sections": [{"html": "", "id": "2059_1", "text": "für die Erteilung eines nationalen Visums vor der Einreise in das Bundesgebiet: die deutsche Auslandsvertretung (Botschaft, Konsulat) nach der Einreise: die Ausländerbehörde, in deren Bezirk Sie sich gewöhnlich aufhalten; Ausländerbehörde ist, je nach Wohnort, die Stadtverwaltung oder das Landratsamt.", "type": "information", "title": "Zuständige Stelle", "order": 1}, {"html": "", "id": "2059_2", "text": "Zur Anzeige der zuständigen Stelle wählen Sie einen Ort.", "type": "information", "title": "Bezugsort", "order": 2}, {"html": "", "id": "2059_3", "text": "Vor der Einreise nach Deutschland müssen Sie in Ihrem Heimatland ein nationales Visum beantragen. Die Vertretung der Bundesrepublik Deutschland beteiligt bei Bedarf die zuständige Ausländerbehörde. Im Visumverfahren müssen Sie Angaben über Ihre Arbeitsstelle im Bundesgebiet machen. So kann die Behörde prüfen, ob die Bundesagentur für Arbeit der Beschäftigung zustimmen muss. Nach der Einreise müssen Sie den Aufenthaltstitel schriftlich bei der Ausländerbehörde beantragen, bevor Ihr Visum oder Ihre bisherige Aufenthaltserlaubnis abläuft. Ausländerbehörde ist, je nach Wohnort, die Stadtverwaltung oder das Landratsamt. Hinweis: Die Ausländerbehörde holt die Zustimmung der Bundesagentur für Arbeit ein, wenn diese erforderlich ist. Auf die Möglichkeit der Durchführung des beschleunigten Fachkräfteverfahrens nach § 81a Aufenthaltsgesetz wird an dieser Stelle hingewiesen.", "type": "information", "title": "Verfahrensablauf", "order": 3}, {"html": "", "id": "2059_4", "text": "keine", "type": "information", "title": "Fristen", "order": 4}, {"html": "", "id": "2059_5", "text": "Nachweis der Erfüllung der Pass- und Visumpflicht Nachweis des Mindestgehalts Nachweis Ihres Hochschulabschlusses Nachweis des Arbeitsplatzes oder Arbeitsplatzangebotes Nachweis, dass kein Ausweisungsinteresse gegen Sie vorliegt Nachweis, dass Sie die Interessen der Bundesrepublik Deutschland nicht gefährden oder beeinträchtigen", "type": "information", "title": "Erforderliche Unterlagen", "order": 5}, {"html": "", "id": "2059_6", "text": "Geltungsdauer bis zu einem Jahr: 100,00 EUR Geltungsdauer über ein Jahr: 100,00 EUR Verlängerung um bis zu drei Monate: 96,00 EUR Verlängerung um mehr als drei Monate: 93,00 EUR", "type": "information", "title": "Kosten", "order": 6}, {"html": "", "id": "2059_7", "text": "Die Bearbeitung dauert in der Regel vier bis acht Wochen.", "type": "information", "title": "Bearbeitungsdauer", "order": 7}, {"html": "", "id": "2059_8", "text": "", "type": "information", "title": "Vertiefende Informationen", "order": 8}, {"html": "", "id": "2059_9", "text": "keine", "type": "information", "title": "Hinweise", "order": 9}, {"html": "", "id": "2059_10", "text": "Widerspruch Klage vor dem Verwaltungsgericht", "type": "information", "title": "Rechtsbehelf", "order": 10}, {"html": "", "id": "2059_11", "text": "Aufenthaltsgesetz (AufenthG) : § 5 Allgemeine Erteilungsvoraussetzungen § 18g Blaue Karte EU § 81a Beschleunigtes Fachkräfteverfahren § 39 Zustimmung der Bundesagentur für Arbeit Aufenthaltsverordnung (AufenthV) : § 45 Gebühr", "type": "information", "title": "Rechtsgrundlage", "order": 11}, {"html": "", "id": "2059_12", "text": "08.01.2026 Justizministerium Baden-Württemberg", "type": "information", "title": "Freigabevermerk", "order": 12}], "requirements": [{"confidence": 0.0, "sourceText": "", "id": "2059_1", "text": "Nachweis der Erfüllung der Pass- und Visumpflicht", "type": "condition", "mandatory": true}, {"confidence": 0.0, "sourceText": "", "id": "2059_2", "text": "Nachweis des Mindestgehalts", "type": "condition", "mandatory": true}, {"confidence": 0.0, "sourceText": "", "id": "2059_3", "text": "Nachweis Ihres Hochschulabschlusses", "type": "condition", "mandatory": true}, {"confidence": 0.0, "sourceText": "", "id": "2059_4", "text": "Nachweis des Arbeitsplatzes oder Arbeitsplatzangebotes", "type": "condition", "mandatory": true}, {"confidence": 0.0, "sourceText": "", "id": "2059_5", "text": "Nachweis, dass kein Ausweisungsinteresse gegen Sie vorliegt", "type": "condition", "mandatory": true}, {"confidence": 0.0, "sourceText": "", "id": "2059_6", "text": "Nachweis, dass Sie die Interessen der Bundesrepublik Deutschland nicht gefährden oder beeinträchtigen", "type": "condition", "mandatory": true}], "documents": [], "authorities": [{"name": "deutsche Auslandsvertretung (Botschaft, Konsulat)", "id": "2059_1", "type": "national"}, {"name": "Ausländerbehörde", "id": "2059_2", "type": "local"}], "forms": [], "steps": [], "legal_basis": [], "goals": [], "dependencies": [], "problems": [], "service_qa": [{"question": "Was ist die Blaue Karte EU?", "answer": "Die Blaue Karte EU ist ein Visum zur Ausübung einer hochqualifizierten Beschäftigung.", "confidence": 0.9, "service_id": "2059", "sourceText": "", "id": "2059_qa_1", "scrapedAt": "2026-05-25T16:41:22.334848", "category": "overview", "order": 1}, {"question": "Wer kann eine Blaue Karte EU beantragen?", "answer": "Einwanderer in das Bundesgebiet Baden-Württemberg können eine Blaue Karte EU beantragen.", "confidence": 0.9, "service_id": "2059", "sourceText": "", "id": "2059_qa_2", "scrapedAt": "2026-05-25T16:41:22.334998", "category": "eligibility", "order": 2}, {"question": "Welche Unterlagen sind erforderlich für den Antrag auf die Blaue Karte EU?", "answer": "Es sind Nachweise des Mindestgehalts, Hochschulabschlusses und ... <truncated 39300 chars>
